# LITERA Backend Environment Configuration Example
PROJECT_NAME="LITERA API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="127.0.0.1"
PORT=8000

# CORS (JSON string array)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (PostgreSQL - Prepared for Phase 3)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/litera"

# Security (JWT & Password Hashing - Prepared for Phase 4)
SECRET_KEY="development_secret_key_change_in_production_min_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
